[Unit]
Description=GroupGuard Telegram bot and web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=groupguard
Group=groupguard
WorkingDirectory=/opt/groupguard
Environment=GROUPGUARD_CONFIG=/opt/groupguard/config.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/groupguard/.venv/bin/python -m app.main
Restart=always
RestartSec=5
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
