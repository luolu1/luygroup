# luygroup Nginx 反向代理示例
# 将 gg.example.com 替换为你的域名，证书路径替换为实际路径。
# 同时把 config.json 的 web.base_url 改为 https://gg.example.com

server {
    listen 80;
    listen [::]:80;
    server_name gg.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gg.example.com;

    ssl_certificate     /etc/letsencrypt/live/gg.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gg.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    client_max_body_size 2m;

    location / {
        proxy_pass         http://127.0.0.1:8090;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
